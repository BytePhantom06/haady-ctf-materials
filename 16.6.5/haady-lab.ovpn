# Haady Training Center — OpenVPN lab configuration
# Lab: 16.6.5 symmetric encryption lesson

client
dev tun
proto udp
remote vpn.haady.uz 1194
resolv-retry infinite
nobind
persist-key
persist-tun

# Symmetric cipher used for the data channel
cipher AES-128-CBC
auth SHA256

# Inline static key (TLS-authentication / pre-shared)
key-direction 1

<tls-auth>
